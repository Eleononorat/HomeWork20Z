          "mode": "raw",
          "raw": "{\r\n  \"id\": \"{{userId}}\",\r\n  \"name\": \"{{userName}}_Updated\",\r\n  \"age\": 30,\r\n  \"gender\": \"{{userGender}}\",\r\n  \"city\": \"Kyiv\"\r\n}",
          "options": {

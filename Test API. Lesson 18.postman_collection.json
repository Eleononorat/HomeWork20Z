  "item": [
    {
      "name": "Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Тест 1: Перевірка успішного створення користувача\r",
              "pm.test(\"Status code is 200 or 201 Created\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "// Тест 2: Запис ID у змінні та перевірка імені\r",
              "pm.test(\"Response body contains id and saves variable\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Перевіряємо наявність поля id\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "    \r",
              "    // Зберігаємо ID у всі рівні змінних Postman для гарантії\r",
              "    pm.environment.set(\"userId\", jsonData.id);\r",
              "    pm.collectionVariables.set(\"userId\", jsonData.id);\r",
              "    pm.globals.set(\"userId\", jsonData.id);\r",
              "    \r",
              "    console.log(\"Збережений ID користувача:\", jsonData.id);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disabledSystemHeaders": {
          "content-length": true,
          "host": true,
          "user-agent": true,
          "accept-encoding": true,
          "accept": true,
          "connection": true
        }
      },
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"{{userName}}\",\r\n  \"age\": {{userAge}},\r\n  \"gender\": \"{{userGender}}\",\r\n  \"city\": \"{{userCity}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Тест 1: Перевірка успішного статусу 200 OK\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Тест 2: Перевірка, що відповів саме той користувач, якого запитували\r",
              "pm.test(\"Returned user matches requested userId\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.id).to.eql(pm.variables.get(\"userId\"));\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?id={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{userId}}",
              "type": "text"
            }
          ]
        }
      },
      "response": []

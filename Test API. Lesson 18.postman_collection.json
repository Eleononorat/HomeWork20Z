              "    pm.expect(pm.response.code).to.be.oneOf([404, 400, 200]);\r",
              "});\r",
              "\r",
              "// Тест 2: Перевірка повідомлення про відсутність користувача\r",
              "pm.test(\"Response indicates user not found\", function () {\r",
              "    var responseText = pm.response.text();\r",
              "    pm.expect(responseText).to.include(\"No users found\");\r",
              "});"

              "\r",
              "// Тест 2: Перевірка повідомлення про видалення (з урахуванням точного тексту сервера)\r",
              "pm.test(\"Response confirms user deletion\", function () {\r",
              "    pm.expect(pm.response.text()).to.include(\"User is deleted\");\r",
              "});"

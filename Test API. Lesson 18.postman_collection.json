              "});\r",
              "\r",
              "// Тест 2: Перевірка тексту помилки про відсутність ID (підтримує \"Id is required\" та \"idisrequiredparameter\")\r",
              "pm.test(\"Response returns 'Id is required' error\", function () {\r",
              "    var responseText = pm.response.text();\r",
              "    pm.expect(responseText.includes(\"Id is required\") || responseText.includes(\"idisrequiredparameter\")).to.be.true;\r",

              "// Тест 1: Перевірка успішного HTTP-статусу 200 OK\r",
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Тест 2: Перевірка, що сервер повернув оновлені дані користувача\r",
              "pm.test(\"User data was successfully updated in response\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"name\");\r",
              "    pm.expect(jsonData.city).to.eql(\"Kyiv\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
